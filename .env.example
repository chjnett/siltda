# Optional. Enables Cesium World Terrain. Without it, the app uses ellipsoid terrain.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Optional. Enables Google Photorealistic 3D Tiles. Provider terms and metered usage apply.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Erosion-risk ML API (FastAPI, see backend/). Production must be an HTTPS URL; browsers block http calls from an https page.
NEXT_PUBLIC_SILTDA_ML_API_URL=http://localhost:8000

# Optional. Enables the Cloudflare Worker + D1 + R2 operations repository.
# Without it, /operations uses an explicit browser-local demonstration repository.
NEXT_PUBLIC_SILTDA_OPERATIONS_API_URL=http://localhost:8787
