{
  "name": "siltda-3d-gis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run copy:cesium && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "copy:cesium": "node scripts/copy-cesium-assets.mjs",
    "postinstall": "npm run copy:cesium",
    "operations:dev": "wrangler dev --config workers/operations-api/wrangler.jsonc --port 8787",
    "operations:dry-run": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --config workers/operations-api/wrangler.jsonc --dry-run --outdir .wrangler-dist",
    "operations:deploy": "wrangler deploy --config workers/operations-api/wrangler.jsonc"
  },
  "dependencies": {
    "cesium": "^1.124.0",
    "earcut": "^3.0.2",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.153.0"
  }
}
